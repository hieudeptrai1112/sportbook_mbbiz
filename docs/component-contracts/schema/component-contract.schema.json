{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbbiz.local/component-contract.schema.json",
  "title": "Sportbook Component Contract",
  "type": "object",
  "required": [
    "component",
    "slug",
    "implementationStatus",
    "overview",
    "states",
    "interactions",
    "api",
    "accessibility",
    "tokens",
    "examples",
    "copySnippets",
    "testMatrix",
    "changelog"
  ],
  "properties": {
    "component": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "implementationStatus": {
      "type": "string",
      "enum": ["shipped", "planned"]
    },
    "version": { "type": "string" },
    "owner": { "type": "string" },
    "overview": {
      "type": "object",
      "required": ["purpose", "useCases", "whenNotToUse"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "useCases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "whenNotToUse": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "visual"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "visual": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event", "from", "to", "notes"],
        "properties": {
          "event": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "api": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "default", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "default": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["roles", "keyboard", "focus", "aria", "contrast"],
      "properties": {
        "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "keyboard": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "focus": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "aria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "contrast": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "required": ["color", "spacing", "typography", "radius", "motion"],
      "properties": {
        "color": { "type": "array", "items": { "$ref": "#/$defs/tokenMapping" } },
        "spacing": { "type": "array", "items": { "$ref": "#/$defs/tokenMapping" } },
        "typography": { "type": "array", "items": { "$ref": "#/$defs/tokenMapping" } },
        "radius": { "type": "array", "items": { "$ref": "#/$defs/tokenMapping" } },
        "motion": { "type": "array", "items": { "$ref": "#/$defs/tokenMapping" } }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "scenario"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "copySnippets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "language", "path", "purpose"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "testMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "assertion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["interaction", "accessibility", "visual", "api"] },
          "assertion": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "change"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "change": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "tokenMapping": {
      "type": "object",
      "required": ["componentToken", "semanticAlias", "notes"],
      "properties": {
        "componentToken": { "type": "string", "minLength": 1 },
        "semanticAlias": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
