        "componentToken": "ds/checkbox/color/border/default",
        "semanticAlias": "border/primary",
        "notes": "Unchecked border"
      }
    ],
    "spacing": [
      {
        "componentToken": "ds/checkbox/spacing/label-gap",
        "semanticAlias": "spacing/2",
        "notes": "Indicator to label gap"
      }
    ],
    "typography": [
      {
        "componentToken": "ds/checkbox/text/label",
        "semanticAlias": "font/size/body-3",
        "notes": "Label text style"
      }
    ],
    "radius": [
      {
        "componentToken": "ds/checkbox/radius",
        "semanticAlias": "radius/none",
        "notes": "Square checkbox corner"
      }
    ],
    "motion": [
      {
        "componentToken": "ds/checkbox/motion/check",
        "semanticAlias": "effect/transition/fast",
        "notes": "Checkmark transition"
      }
    ]
  },
  "examples": [
    {
      "id": "checkbox-basic-toggle",
      "title": "Boolean setting",
      "description": "Single checkbox bound to one settings flag.",
      "scenario": "Settings panel"
    },
    {
      "id": "checkbox-parent-child",
      "title": "Parent-child group",
      "description": "Indeterminate state based on child selections.",
      "scenario": "Bulk select"
    }
  ],
  "copySnippets": [
