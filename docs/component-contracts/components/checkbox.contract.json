{
  "component": "Checkbox",
  "slug": "checkbox",
  "implementationStatus": "planned",
  "version": "1.0.0",
  "owner": "Design System",
  "overview": {
    "purpose": "Checkbox captures boolean or multi-select state.",
    "useCases": [
      "Enable or disable optional settings",
      "Select multiple items in a list",
      "Bulk selection in tables"
    ],
    "whenNotToUse": [
      "Mutually exclusive choices (use Radio)",
      "Immediate destructive actions without confirmation"
    ]
  },
  "states": [
    {
      "name": "unchecked",
      "description": "Default off state.",
      "visual": "Empty box"
    },
    {
      "name": "checked",
      "description": "Selected state.",
      "visual": "Checkmark visible"
    },
    {
      "name": "indeterminate",
      "description": "Partial selection in parent node.",
      "visual": "Dash marker"
    },
    {
      "name": "disabled",
      "description": "Read-only non-interactive state.",
      "visual": "Muted box and label"
    }
  ],
  "interactions": [
    {
      "event": "click label",
      "from": "unchecked",
      "to": "checked",
      "notes": "Toggles state through label hit area."
    },
    {
      "event": "click label",
      "from": "checked",
      "to": "unchecked",
      "notes": "Second click toggles back."
    },
    {
      "event": "set parent partial",
      "from": "unchecked",
      "to": "indeterminate",
      "notes": "Group state indicates partial selection."
    },
    {
      "event": "set disabled=true",
      "from": "checked",
      "to": "disabled",
      "notes": "Locks state and suppresses toggle."
    }
  ],
  "api": [
    {
      "name": "checked",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Controlled checked state."
    },
    {
      "name": "indeterminate",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Partial state for grouped selections."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Disables toggle interaction."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "default": "''",
      "description": "Visible label associated with input."
    },
    {
      "name": "onChange",
      "type": "(checked: boolean) => void",
      "required": false,
      "default": "undefined",
      "description": "Emits updated checked state."
    }
  ],
  "accessibility": {
    "roles": [
      "Use native checkbox input for role and state announcements."
    ],
    "keyboard": [
      "Space toggles checked state when focused.",
      "Tab enters checkbox in document order."
    ],
    "focus": [
      "Focus indicator appears on checkbox root and label remains readable.",
      "Indeterminate state does not remove focus indicator."
    ],
    "aria": [
      "Use aria-checked='mixed' for indeterminate state.",
      "Associate label via for/id or implicit label wrapping."
    ],
    "contrast": [
      "Checkmark remains visible at all states and themes.",
      "Disabled label and box meet non-text contrast guidance."
    ]
  },
  "tokens": {
    "color": [
      {
        "componentToken": "ds/checkbox/color/background/checked",
        "semanticAlias": "background/brand-primary1",
        "notes": "Checked fill"
      },
