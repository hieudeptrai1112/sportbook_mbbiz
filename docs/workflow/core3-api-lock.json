{
  "version": "2026-04-21",
  "description": "API lock for core-3 components. Any input/output drift must be intentional and reviewed.",
  "components": [
    {
      "name": "button",
      "selector": "mbbiz-button",
      "entry": "projects/mbbiz/src/lib/components/button/button.component.ts",
      "publicApiExport": "./lib/components/button/button.component",
      "inputs": [
        { "name": "variant", "type": "MbbizButtonVariant", "default": "'primary'" },
        { "name": "size", "type": "MbbizButtonSize", "default": "'md'" },
        { "name": "shape", "type": "MbbizButtonShape", "default": "'rectangle'" },
        { "name": "disabled", "type": null, "default": "false" },
        { "name": "loading", "type": null, "default": "false" },
        { "name": "fullWidth", "type": null, "default": "false" },
        { "name": "type", "type": "'button' | 'submit' | 'reset'", "default": "'button'" },
        { "name": "ariaLabel", "type": "string | null", "default": "null" }
      ],
      "outputs": [{ "name": "buttonClick", "type": "MouseEvent" }],
      "previewSelectors": ["mbbiz-button"]
    },
    {
      "name": "input",
      "selector": "mbbiz-input",
      "entry": "projects/mbbiz/src/lib/components/input/input.component.ts",
      "publicApiExport": "./lib/components/input/input.component",
      "inputs": [
        { "name": "value", "type": null, "default": "''" },
        { "name": "placeholder", "type": null, "default": "''" },
        { "name": "disabled", "type": null, "default": "false" },
        { "name": "size", "type": "MbbizInputSize", "default": "'md'" },
        { "name": "status", "type": "MbbizInputStatus", "default": "'default'" },
        { "name": "type", "type": "'text' | 'email' | 'number' | 'password' | 'search'", "default": "'text'" },
        { "name": "inputId", "type": "string | null", "default": "null" },
        { "name": "label", "type": "string | null", "default": "null" },
        { "name": "hint", "type": "string | null", "default": "null" },
        { "name": "errorMessage", "type": "string | null", "default": "null" }
      ],
      "outputs": [{ "name": "valueChange", "type": "string" }],
      "previewSelectors": [
        "mbbiz-input",
        "mbbiz-affix-input",
        "mbbiz-search-input",
        "mbbiz-password-input",
        "mbbiz-textarea",
        "mbbiz-floating-label-input",
        "mbbiz-affix-label-input",
        "mbbiz-input-tag"
      ]
    },
    {
      "name": "dropdown",
      "selector": "mbbiz-dropdown",
      "entry": "projects/mbbiz/src/lib/components/dropdown/dropdown.component.ts",
      "publicApiExport": "./lib/components/dropdown/dropdown.component",
      "inputs": [
        { "name": "title", "type": null, "default": "'Title'" },
        { "name": "placeholder", "type": null, "default": "'Lựa chọn'" },
        { "name": "items", "type": "readonly MbbizDropdownItem[]", "default": "[]" },
        { "name": "mode", "type": "MbbizDropdownMode", "default": "'single'" },
        { "name": "labelMode", "type": "MbbizDropdownLabelMode", "default": "'outside'" },
        { "name": "status", "type": "MbbizDropdownStatus", "default": "'default'" },
        { "name": "disabled", "type": null, "default": "false" },
        { "name": "errorMessage", "type": "string | null", "default": "null" },
        { "name": "value", "type": "string | null", "default": "null" },
        { "name": "values", "type": "readonly string[]", "default": "[]" },
        { "name": "open", "type": null, "default": "false" },
        { "name": "searchBehavior", "type": "MbbizDropdownSearchBehavior", "default": "'auto'" },
        { "name": "searchThreshold", "type": null, "default": "5" },
        { "name": "emptyState", "type": "MbbizDropdownEmptyState", "default": "'none'" },
        { "name": "retryDelayMs", "type": null, "default": "3000" }
      ],
      "outputs": [
        { "name": "valueChange", "type": "string | null" },
        { "name": "valuesChange", "type": "string[]" },
        { "name": "itemSelect", "type": "MbbizDropdownItem" },
        { "name": "openChange", "type": "boolean" },
        { "name": "retryRequest", "type": "void" }
      ],
      "previewSelectors": ["mbbiz-dropdown", "mbbiz-dropdown-tag"]
    }
  ]
}
