{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/mbbiz",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*",
      "input": "src/lib/foundations/tokens",
      "output": "tokens"
    },
    {
      "glob": "**/*",
      "input": "src/lib/components/badge/assets",
      "output": "badge-assets"
    }
  ]
}
