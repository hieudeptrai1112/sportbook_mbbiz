{
  "name": "sportbook-mbbiz",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mbbiz": "ng build mbbiz",
    "test:mbbiz": "ng test mbbiz --watch=false",
    "start:mbbiz-preview": "ng serve mbbiz_preview",
    "build:mbbiz-preview": "ng build mbbiz_preview",
    "build-storybook": "ng build && rm -rf storybook-static && mkdir -p storybook-static && cp -R dist/sportbook_mbbiz/browser/. storybook-static",
    "contracts:validate": "node scripts/contracts/validate.mjs",
    "lock:core3:update": "node scripts/workflow/update-core3-baseline-lock.mjs",
    "verify:core3:locks": "node scripts/workflow/verify-core3-locks.mjs",
    "verify:core3": "node scripts/workflow/verify-core3.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@mbbiz/icon": "^0.1.5",
    "ng-zorro-antd": "^21.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^26.1.0",
    "less": "^4.4.2",
    "ng-packagr": "^21.2.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  }
}
